//@version=6
// =============================================================================
// Watchlist Flip Scanner  —  COMPILE-VERIFIED on TradingView (Pine v6)
// -----------------------------------------------------------------------------
// One alert covering up to 25 tickers. Uses 25 request.security() calls (limit 40).
// =============================================================================

indicator("Watchlist Flip Scanner", overlay = false)

atrLen = input.int(10, "ATR length", minval = 1, group = "Signal")
factor = input.float(3.0, "Factor", minval = 0.1, step = 0.1, group = "Signal")
tf = input.timeframe("", "Timeframe", group = "Signal")

alertFirst = input.bool(false, "Alert on first signal too", group = "Behavior")
showTable = input.bool(true, "Show status table", group = "Display")

g1 = "Symbols 1-8"
g2 = "Symbols 9-16"
g3 = "Symbols 17-25"
s01 = input.symbol("NASDAQ:SPCX", "01", group = g1)
s02 = input.symbol("NASDAQ:PLTR", "02", group = g1)
s03 = input.symbol("NASDAQ:NFLX", "03", group = g1)
s04 = input.symbol("NASDAQ:TSLA", "04", group = g1)
s05 = input.symbol("AMEX:SOXL", "05", group = g1)
s06 = input.symbol("NASDAQ:TQQQ", "06", group = g1)
s07 = input.symbol("NASDAQ:SQQQ", "07", group = g1)
s08 = input.symbol("NASDAQ:MU", "08", group = g1)
s09 = input.symbol("NASDAQ:MSTR", "09", group = g2)
s10 = input.symbol("NASDAQ:NBIS", "10", group = g2)
s11 = input.symbol("COINBASE:SOLUSD", "11", group = g2)
s12 = input.symbol("CME_MINI:MNQ1!", "12", group = g2)
s13 = input.symbol("COMEX_MINI:MGC1!", "13", group = g2)
s14 = input.symbol("CME_MINI:MES1!", "14", group = g2)
s15 = input.symbol("NYMEX:MCL1!", "15", group = g2)
s16 = input.symbol("CBOT_MINI:MYM1!", "16", group = g2)
s17 = input.symbol("BITSTAMP:ETHUSD", "17", group = g3)
s18 = input.symbol("BITSTAMP:BTCUSD", "18", group = g3)
s19 = input.symbol("BINANCE:BNBUSDT", "19", group = g3)
s20 = input.symbol("COINBASE:HYPEUSD", "20", group = g3)
s21 = input.symbol("KRAKEN:ADAUSD", "21", group = g3)
s22 = input.symbol("BINANCE:NEARUSD", "22", group = g3)
s23 = input.symbol("COINBASE:XRPUSD", "23", group = g3)
s24 = input.symbol("COINBASE:LINKUSD", "24", group = g3)
s25 = input.symbol("NASDAQ:HOOD", "25", group = g3)

regime() =>
    [_st, dir] = ta.supertrend(factor, atrLen)
    dir == -1 ? 1 : -1

fetch(simple string sym) =>
    request.security(sym, tf, regime(), lookahead = barmerge.lookahead_off)

r01 = fetch(s01)
r02 = fetch(s02)
r03 = fetch(s03)
r04 = fetch(s04)
r05 = fetch(s05)
r06 = fetch(s06)
r07 = fetch(s07)
r08 = fetch(s08)
r09 = fetch(s09)
r10 = fetch(s10)
r11 = fetch(s11)
r12 = fetch(s12)
r13 = fetch(s13)
r14 = fetch(s14)
r15 = fetch(s15)
r16 = fetch(s16)
r17 = fetch(s17)
r18 = fetch(s18)
r19 = fetch(s19)
r20 = fetch(s20)
r21 = fetch(s21)
r22 = fetch(s22)
r23 = fetch(s23)
r24 = fetch(s24)
r25 = fetch(s25)

var int[] prev = array.new_int(25, 0)

check(int idx, string sym, float cur) =>
    string out = ""
    if not na(cur)
        int c = int(cur)
        int p = array.get(prev, idx)
        bool isFlip = p != 0 and c != p
        bool isFirst = p == 0
        if isFlip or (alertFirst and isFirst)
            string arrow = p == 1 ? "BUY>SELL" : p == -1 ? "SELL>BUY" : "NEW " + (c == 1 ? "BUY" : "SELL")
            out := arrow + " " + sym + "  "
        if barstate.isconfirmed
            array.set(prev, idx, c)
    out

msgs = ""
if barstate.isconfirmed
    msgs := check(0, s01, r01)
    msgs := msgs + check(1, s02, r02)
    msgs := msgs + check(2, s03, r03)
    msgs := msgs + check(3, s04, r04)
    msgs := msgs + check(4, s05, r05)
    msgs := msgs + check(5, s06, r06)
    msgs := msgs + check(6, s07, r07)
    msgs := msgs + check(7, s08, r08)
    msgs := msgs + check(8, s09, r09)
    msgs := msgs + check(9, s10, r10)
    msgs := msgs + check(10, s11, r11)
    msgs := msgs + check(11, s12, r12)
    msgs := msgs + check(12, s13, r13)
    msgs := msgs + check(13, s14, r14)
    msgs := msgs + check(14, s15, r15)
    msgs := msgs + check(15, s16, r16)
    msgs := msgs + check(16, s17, r17)
    msgs := msgs + check(17, s18, r18)
    msgs := msgs + check(18, s19, r19)
    msgs := msgs + check(19, s20, r20)
    msgs := msgs + check(20, s21, r21)
    msgs := msgs + check(21, s22, r22)
    msgs := msgs + check(22, s23, r23)
    msgs := msgs + check(23, s24, r24)
    msgs := msgs + check(24, s25, r25)
    if str.length(msgs) > 0
        alert("FLIP: " + msgs, alert.freq_once_per_bar_close)

var table t = table.new(position.top_right, 2, 26, border_width = 1)

row(int i, string sym, float v) =>
    bool isBuy = not na(v) and v == 1
    table.cell(t, 0, i, sym, text_size = size.tiny, text_color = color.new(color.white, 20))
    table.cell(t, 1, i, na(v) ? "-" : isBuy ? "BUY" : "SELL", text_size = size.tiny, text_color = color.white, bgcolor = na(v) ? color.new(color.gray, 60) : isBuy ? color.new(color.teal, 25) : color.new(color.red, 25))

if showTable and barstate.islast
    table.cell(t, 0, 0, "Symbol", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, 0, "State", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.tiny)
    row(1, s01, r01)
    row(2, s02, r02)
    row(3, s03, r03)
    row(4, s04, r04)
    row(5, s05, r05)
    row(6, s06, r06)
    row(7, s07, r07)
    row(8, s08, r08)
    row(9, s09, r09)
    row(10, s10, r10)
    row(11, s11, r11)
    row(12, s12, r12)
    row(13, s13, r13)
    row(14, s14, r14)
    row(15, s15, r15)
    row(16, s16, r16)
    row(17, s17, r17)
    row(18, s18, r18)
    row(19, s19, r19)
    row(20, s20, r20)
    row(21, s21, r21)
    row(22, s22, r22)
    row(23, s23, r23)
    row(24, s24, r24)
    row(25, s25, r25)